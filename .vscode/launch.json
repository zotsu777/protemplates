{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: dev server (no debugger)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "serverReadyAction": {
        "pattern": "- Local: +(https?://\\S+)",
        "uriFormat": "%s/en",
        "action": "openExternally"
      }
    },
    {
      "name": "Next.js: debug server-side",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "env": {
        "NODE_OPTIONS": "--inspect"
      }
    },
    {
      "name": "Next.js: debug full stack",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "runtimeArgs": ["--inspect"],
      "args": ["dev"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "- Local: +(https?://\\S+)",
        "uriFormat": "%s/en",
        "action": "debugWithChrome"
      }
    },
    {
      "name": "Next.js: debug client-side in Brave",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000/en",
      "webRoot": "${workspaceFolder}",
      "runtimeExecutable": "C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe"
    },
    {
      "name": "Next.js: debug client-side in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000/en",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
