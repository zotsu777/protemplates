{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "detail": "Start the Next.js dev server on http://localhost:3000",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "next",
        "pattern": {
          "regexp": "^(?!.*Ready in).*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting|Creating an optimized",
          "endsPattern": "Ready in"
        }
      },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "build",
      "detail": "Production build",
      "type": "npm",
      "script": "build",
      "group": "build",
      "problemMatcher": "$tsc"
    },
    {
      "label": "lint",
      "detail": "Run ESLint",
      "type": "npm",
      "script": "lint",
      "problemMatcher": "$eslint-stylish"
    },
    {
      "label": "typecheck",
      "detail": "Type-check without emitting",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": "$tsc"
    }
  ]
}
